# Spark application configuration
spark.master                     yarn
spark.submit.deployMode          client

# YARN Configuration
# Using local JARs instead of HDFS archive for simplicity
# spark.yarn.jars                  hdfs://{{ resourcemanager_ip }}:9000/spark/jars/*.jar
# spark.yarn.archive               hdfs://{{ resourcemanager_ip }}:9000/spark/spark-libs.tar.gz

# Application Properties
spark.driver.memory              1g
spark.executor.memory            1g
spark.executor.cores             1
spark.executor.instances         2

# Spark History Server
spark.eventLog.enabled           true
spark.eventLog.dir               hdfs://{{ resourcemanager_ip }}:9000/spark/logs
spark.history.fs.logDirectory    hdfs://{{ resourcemanager_ip }}:9000/spark/logs

# Serialization
spark.serializer                 org.apache.spark.serializer.KryoSerializer

# Hive Integration
# Use Spark's builtin Hive 2.3.9 client to connect to external Hive Metastore via Thrift
# The Thrift protocol handles version differences between client and server
spark.sql.hive.metastore.version           2.3.9
spark.sql.hive.metastore.jars              builtin
spark.sql.warehouse.dir                     hdfs://{{ resourcemanager_ip }}:9000{{ hive_metastore_warehouse_dir | default('/user/hive/warehouse') }}
spark.sql.catalogImplementation             hive
spark.hadoop.hive.metastore.uris            {{ hive_metastore_uri | default('thrift://192.168.1.15:9083') }}

# Dynamic Allocation (disabled by default for stability)
# To enable, uncomment these lines and configure Spark Shuffle Service in YARN
spark.dynamicAllocation.enabled             false
# spark.dynamicAllocation.minExecutors        1
# spark.dynamicAllocation.maxExecutors        3
# spark.dynamicAllocation.initialExecutors    2
# spark.shuffle.service.enabled               true
# spark.dynamicAllocation.shuffleTracking.enabled true

# Network Timeout (for stable connections)
spark.network.timeout                       300s
spark.executor.heartbeatInterval            60s

# UI Configuration
spark.ui.enabled                            true
spark.ui.port                               4040

# Partition configuration
spark.sql.shuffle.partitions                8
spark.default.parallelism                   8


